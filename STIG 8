#SYNOPSIS
This PowerShell script ensures that the Application event log size is configured to 32768 KB or greater. 

#NOTES
STIG-ID: WN11-AU-000500
 

#Code: 
New-Item -Path "HKLM:\SOFTWARE\Policies\Microsoft\Windows\EventLog\Application" -Force | New-ItemProperty -Name "MaxSize" -Value 32768 -PropertyType DWord -Force | Out-Null

#Verify: 
(Get-ItemProperty "HKLM:\SOFTWARE\Policies\Microsoft\Windows\EventLog\Application").MaxSize
